# Postgresql
export SEC_POSTGRES_PASSWORD=""

# Avenirs Portfolio API
export SEC_AVENIRS_PORTFOLIO_API_ROME_4_CLIENT_ID=""
export SEC_AVENIRS_PORTFOLIO_API_ROME_4_CLIENT_SECRET=""

# Avenirs Portfolio API - file storage backend. Sourced before srv-dev-env.sh
# applies its own default, so the value set here wins:
#   local -> the avenirs-minio container started by the stack (default)
#   s3    -> an online S3-compatible service, configured by the entries below
export AVENIRS_PORTFOLIO_STORAGE_BACKEND="local"

# Avenirs Portfolio API - online S3 file storage.
# Only required when AVENIRS_PORTFOLIO_STORAGE_BACKEND=s3; the local MinIO container
# is used otherwise and needs none of these.
# The access key and the secret key are the "username" and "password" of the
# S3 service. Region defaults to eu-west-3 when left empty; a backend that
# validates it reports the value it expects in its error message.
export SEC_AVENIRS_PORTFOLIO_API_S3_ENDPOINT=""
export SEC_AVENIRS_PORTFOLIO_API_S3_REGION="eu-west-3"
export SEC_AVENIRS_PORTFOLIO_API_S3_BUCKET=""
export SEC_AVENIRS_PORTFOLIO_API_S3_ACCESS_KEY=""
export SEC_AVENIRS_PORTFOLIO_API_S3_SECRET_KEY=""
# Set to false only if the backend serves buckets as <bucket>.<endpoint>
export SEC_AVENIRS_PORTFOLIO_API_S3_PATH_STYLE_ACCESS="true"