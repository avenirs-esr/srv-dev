ARG JAVA_ALPINE_VERSION=25-jdk-alpine

FROM eclipse-temurin:${JAVA_ALPINE_VERSION} as build
ARG MAVEN_VERSION=3.9.9
COPY ./maven-dist/apache-maven-${MAVEN_VERSION}-bin.zip /tmp/maven.zip
RUN unzip -q /tmp/maven.zip -d /opt && ln -s /opt/apache-maven-${MAVEN_VERSION}/bin/mvn /usr/local/bin/mvn && rm /tmp/maven.zip
WORKDIR /workspace/app
COPY ./avenirs-portfolio-back-office/.mvn .mvn
COPY ./avenirs-portfolio-back-office/pom.xml .
COPY ./avenirs-portfolio-back-office/libs libs
COPY ./avenirs-portfolio-back-office/src src

RUN --mount=type=cache,id=maven-repo,target=/root/.m2,sharing=locked mvn spotless:apply
RUN --mount=type=cache,id=maven-repo,target=/root/.m2,sharing=locked mvn clean install package -DskipTests
RUN mkdir -p ./target/dependency && (cd ./target/dependency; jar -xf ../*.jar)


FROM eclipse-temurin:${JAVA_ALPINE_VERSION}
WORKDIR /workspace/app
VOLUME /tmp
ARG DEPENDENCY=/workspace/app/target/dependency
COPY --from=build ${DEPENDENCY}/BOOT-INF/lib /app/lib
COPY --from=build ${DEPENDENCY}/META-INF /app/META-INF
COPY --from=build /workspace/app/target/avenirs-portfolio-back-office-*-SNAPSHOT.jar /app/avenirs-portfolio-back-office.jar

ARG JAVA_XMX=2048M
ENV JAVA_XMX=${JAVA_XMX}

ENTRYPOINT exec java -server -noverify -Xmx${JAVA_XMX} -jar /app/avenirs-portfolio-back-office.jar