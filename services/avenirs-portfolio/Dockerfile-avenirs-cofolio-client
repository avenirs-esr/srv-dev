ARG NODE_ALPINE_VERSION=26-alpine
ARG NGINX_VERSION=alpine

FROM node:${NODE_ALPINE_VERSION} AS build
ARG PNPM_VERSION=10.34.2
WORKDIR /app

ENV IS_DOCKER=true
ENV HUSKY=0

RUN npm install --global "pnpm@${PNPM_VERSION}"

COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter avenirs-cofolio-client run build-only
RUN pnpm --filter avenirs-cofolio-client run type-check
RUN pnpm --filter avenirs-cofolio-client run lint

FROM nginx:${NGINX_VERSION}
COPY --from=build /app/apps/avenirs-cofolio-client/dist /usr/share/nginx/html/cofolio
RUN echo '\
server {\
    listen 80;\
    server_name localhost;\
\
    location /cofolio/ {\
        root /usr/share/nginx/html;\
        index index.html;\
        try_files $uri $uri/ /cofolio/index.html;\
    }\
}\
' > /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
