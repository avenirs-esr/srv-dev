ARG NODE_ALPINE_VERSION=22-alpine
ARG NGINX_VERSION=alpine

FROM node:${NODE_ALPINE_VERSION} AS build
WORKDIR /app

ENV IS_DOCKER=true

COPY . .
RUN npm ci
RUN npm run build-only
RUN npm run type-check
RUN npm run lint

FROM nginx:${NGINX_VERSION}
COPY --from=build /app/dist /usr/share/nginx/html/cofolio
COPY --from=build /app/.env /usr/share/nginx/html/cofolio/.env
RUN echo '\
server {\
    listen 80;\
    server_name localhost;\
\
    location /cofolio/ {\
        root /usr/share/nginx/html;\
        index index.html;\
        try_files $uri $uri/ /cofolio/index.html;\
    }\
}\
' > /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
