### Delegated authentication (SAML2) to the FER - CAS 8.0.0, properties verified against that exact
### version (not master/development/7.x). Full rationale, activation procedure and what remains to
### get from FER: services/cas/README-SAML.md
### Gradle: org.apereo.cas:cas-server-support-pac4j-webflow + org.apereo.cas:cas-server-support-pac4j-saml
### Keystore: services/cas/scripts/cas-saml-init.sh (idempotent)
### /!\ DO NOT UNCOMMENT before a resolvable FER metadata file (test federation first) exists at the
### identity-provider-metadata-path below - CAS starts fine either way (lazy-init), but pac4j cannot
### generate/serve SP metadata without it (see README-SAML.md).
cas.authn.pac4j.saml[0].client-name=FER
cas.authn.pac4j.saml[0].service-provider-entity-id=${cas.server.prefix}/saml/fer
cas.authn.pac4j.saml[0].keystore-path=/etc/cas/saml/fer-sp-keystore.jks
cas.authn.pac4j.saml[0].keystore-password=__SEC_CAS_SAML_FER_KEYSTORE_PASSWORD__
cas.authn.pac4j.saml[0].private-key-password=__SEC_CAS_SAML_FER_PRIVATE_KEY_PASSWORD__
cas.authn.pac4j.saml[0].metadata.service-provider.file-system.location=/etc/cas/saml/fer-sp-metadata.xml
### /!\ TO BE PROVIDED BY FER (do not fabricate)
cas.authn.pac4j.saml[0].metadata.identity-provider-metadata-path=https://pub.federation.renater.fr/metadata/test/idps.xml
### /!\ TO BE CONFIRMED BY FER (do not fabricate) - matches our JDBC principal source ("eppn")
cas.authn.pac4j.saml[0].principal-id-attribute=eduPersonPrincipalName

### Connexion PostgreSQL / Security principal
cas.authn.jdbc.query[0].sql=SELECT password_hash, eppn FROM dev.principal WHERE eppn = ?
cas.authn.jdbc.query[0].field-password=password_hash
cas.authn.jdbc.query[0].principal-attribute-list=eppn
cas.authn.jdbc.query[0].driver-class=org.postgresql.Driver
cas.authn.jdbc.query[0].url=jdbc:postgresql://avenirs-pgsql-primary:5432/avenirs_access_control
cas.authn.jdbc.query[0].user=pguser
cas.authn.jdbc.query[0].password=__SEC_POSTGRES_PASSWORD__

cas.authn.jdbc.query[0].password-encoder.type=BCRYPT

#cas.authn.oidc.core.claims-map.email=mail
cas.authn.oidc.core.claims-map.email=eppn
#cas.authn.oidc.core.claims-map.given_name=givenName
#cas.authn.oidc.core.claims-map.family_name=sn

cas.authn.oidc.id-token.include-id-token-claims=false
cas.authn.oauth.access-token.crypto.enabled=true
cas.authn.oauth.access-token.crypto.encryption-enabled=true



cas.service-registry.json.location=file:/etc/cas/services
cas.service-registry.json.watcher-enabled=true

cas.authn.oidc.discovery.scopes=openid,profile,email,offline_access
#cas.authn.oidc.discovery.claims=family_name,given_name,email, mail, cn,givenName,sn,displayName,isMemberOf
cas.authn.oidc.discovery.claims=family_name,given_name,email
cas.authn.oidc.discovery.code-challenge-methods-supported=S256

# Time in seconds
cas.authn.oauth.access-token.max-time-to-live-in-seconds=600
cas.authn.oauth.refresh-token.time-to-kill-in-seconds=28800

#cas.interrupt.core.force-execution=true
#cas.interrupt.groovy.location=file:/etc/cas/config/interrupt/interrupt-inquirer.groovy
#cas.interrupt.core.trigger-mode=AFTER_SSO
cas.interrupt.cookie.crypto.encryption.key=__SEC_CAS_INTERRUPT_COOKIE_CRYPTO_ENCRYPTION_KEY__
cas.interrupt.cookie.crypto.signing.key=__SEC_CAS_INTERRUPT_COOKIE_CRYPTO_SIGNING_KEY__

cas.audit.slf4j.use-single-line=true


cas.tgc.crypto.encryption.key=__SEC_CAS_TGC_CRYPTO_ENCRYPTION_KEY__
cas.tgc.crypto.signing.key=__SEC_CAS_TGC_CRYPTO_SIGNING_KEY__
cas.webflow.crypto.signing.key=__SEC_CAS_WEBFLOW_CRYPTO_SIGNING_KEY__
cas.webflow.crypto.encryption.key=__SEC_CAS_WEBFLOW_CRYPTO_ENCRYPTION_KEY__
cas.authn.oauth.crypto.encryption.key=__SEC_CAS_AUTHN_OAUTH_CRYPTO_ENCRYPTION_KEY__
cas.authn.oauth.crypto.signing.key=__SEC_CAS_AUTHN_OAUTH_CRYPTO_SIGNING_KEY__
cas.authn.oauth.access-token.crypto.encryption.key=__SEC_CAS_AUTHN_OAUTH_ACCESS_TOKEN_CRYPTO_ENCRYPTION_KEY__
cas.authn.oauth.access-token.crypto.signing.key=__SEC_CAS_AUTHN_OAUTH_ACCESS_TOKEN_CRYPTO_SIGNING_KEY__

spring.security.user.name=casuser
spring.security.user.password=__SEC_CAS_SPRING_SECURITY_USER_PASSWORD__

server.forward-headers-strategy=native
server.tomcat.remoteip.protocol-header=x-forwarded-proto
server.tomcat.remoteip.remote-ip-header=x-forwarded-for
server.tomcat.remoteip.host-header=x-forwarded-host
server.tomcat.remoteip.port-header=x-forwarded-port

