cas.server.name=__DYN_AVENIRS_CAS_SERVER_NAME__
cas.server.prefix=${cas.server.name}/cas
cas.authn.oidc.core.issuer=${cas.server.prefix}/oidc
cas.authn.oidc.core.accepted-issuers-pattern=https:\/\/(avenirs-apache|localhost|(dev|qualif|recette)\.avenirs-esr\.fr|srv-dev-avenirs?(\\.srv-avenir\\.brgm\\.recia\\.net)?)(:8443)?\/cas\/.*

cas.logout.follow-service-redirects=true

logging.config=file:/etc/cas/config/log4j2.xml

cas.authn.accept.users=

